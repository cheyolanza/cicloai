VITE_APP_NAME=CicloAI
VITE_ENABLE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6LcYJMcsAAAAANnSzsP1VP4bJ86DKcGQzhVbZNO2
RECAPTCHA_PROJECT_ID=ciclo-ai
RECAPTCHA_SITE_KEY=6LcYJMcsAAAAANnSzsP1VP4bJ86DKcGQzhVbZNO2
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENABLE_MOCKS=true

# Local Docker/PostgreSQL configuration.
# If DATABASE_URL is set, it takes precedence over DB_* variables.
DATABASE_URL=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cicloai-db
DB_USER=cicloai_user
DB_PASSWORD=cicloai_pass_DB1

# Cloud SQL configuration for Cloud Run.
# Example: ciclo-ai:us-central1:cicloai-postgres
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
JWT_SECRET_KEY=change-me-local-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
GOOGLE_RECAPTCHA_SECRET_KEY=
ENABLE_CAPTCHA_MOCK=true

OPENAI_API_KEY=
RAG_AUTO_INDEX=true
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_DOCUMENTS_DIR=assets/documents/category_rules
RAG_VECTOR_STORE_DIR=storage/vector_store
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json
GOOGLE_CLOUD_PROJECT_ID=ciclo-ai
ENABLE_OCR_MOCK=false
GOOGLE_VISION_OCR_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
PAYMENT_PROOFS_STORAGE_DIR=assets/payments
CATEGORY_RULES_PDF_PATH=assets/documents/category_rules/convocatoria.txt
ENABLE_RAG_MOCK=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cicloai-frontend-674379443086.us-central1.run.app,https://cicloai.com,https://www.cicloai.com
RUN_DB_MIGRATIONS=true
RUN_DB_SEED=true
