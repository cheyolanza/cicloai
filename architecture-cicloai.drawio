<mxfile host="app.diagrams.net">
  <diagram name="CicloAI Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="user" value="Usuario" style="ellipse" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="100" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="web" value="Web App" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="140" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="API Gateway (FastAPI)" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="agent" value="LLM Orchestrator" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="650" y="200" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="PostgreSQL" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ocr" value="OCR Service" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="900" y="200" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="payment" value="Payment Service" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="email" value="Email Service" style="rounded=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="200" width="160" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>